#
# Remove # to use NVL mode.
#

#[callmacro name="nvl-mode"]

#
# Force a locale if you want.
#  - There are 3 languages implemented in this sample game.
#  - The language can be switched by the config GUI.
#  - If not specified here (that is, commented out here), your OS locale will be used.
#
[defmacro name="testmacro"]
   [text text="测试宏"]
[endmacro]

[defmacro name="testmacro2"]
   [text text="${arg1}"]
[endmacro]

[defmacro name="returnmacro"]
   [if lhs="${has_key}" op="==" rhs="false"]
      [text text="The door is locked."]
      [returnmacro]
   [endif]
   # 只有当 has_key 为 true 时，这部分才会运行
   [text text="You unlocked the door with the key!"]
[endmacro]
[config name="game.locale" value="en"]
#[config name="game.locale" value="zh-cn"]
#[config name="game.locale" value="ja"]

#
# Title Screen
#

# Play a BGM.
#[volume track="bgm" vol="0.5"]
[bgm file="sound/bgm/start.ogg"]

# Show a GUI.
[gui file="system/title/title.gui"]

# Will be jumped to here.
[label name="start"]
[volume track="bgm" vol="0.0" span="1.0"]

# 测试所有标签
[chapter name="test"]
[label name="testanime"]
[choose text1="测试移动动画" text2="测试旋转动画" text3="进入下一个测试" name="opt" value1="1" value2="2" value3="3"]
[if lhs="${opt}" op="==" rhs="1"]
   [ch left="images/ch/RenHaiKing39.png"]
   [anime file="system/anime/move.anime"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [ch left="images/ch/RenHaiKing39.png"]
   [anime file="system/anime/rotate.anime"]
[elseif lhs="${opt}" op="==" rhs="3"]
   [ch left="none"]
   [goto name="testbg"]
[endif]
[goto name="testanime"]

[label name="testbg"]
[choose text1="测试背景" text2="测试淡入normal" text3="测试rule淡入" text4="测试melt淡入" text5="进入下一个测试" name="opt" 
value1="1" value2="2" value3="3" value4="4" value5="5" value6="6"]
[if lhs="${opt}" op="==" rhs="1"]
   [bg file="images/bg/school.png"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [bg file="images/bg/black.png"]
   [bg file="images/bg/white.png" time="1.0" method="normal"]
[elseif lhs="${opt}" op="==" rhs="3"]
   [bg file="images/bg/black.png"]
   [bg file="images/bg/school.png" time="1.0" method="rule" rule="images/rule/bg_rule_image/001.png"]
[elseif lhs="${opt}" op="==" rhs="4"]
   [bg file="images/bg/black.png"]
   [bg file="images/bg/school.png" time="1.0" method="melt" rule="images/rule/bg_rule_image/001.png"]
[elseif lhs="${opt}" op="==" rhs="5"]
   [goto name="testbg2"]
[endif]
[goto name="testbg"]

[label name="testbg2"]
[choose text1="图片透明度测试 alpha:255" text2="图片透明度测试 alpha:128" text3="图片透明度测试 alpha:0" text4="进入下一个测试" name="opt"
value1="1" value2="2" value3="3"]
[if lhs="${opt}" op="==" rhs="1"]
   [bg file="images/bg/school.png" alpha="255"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [bg file="images/bg/school.png" alpha="128"]
[elseif lhs="${opt}" op="==" rhs="3"]
   [bg file="images/bg/school.png" alpha="0"]
[elseif lhs="${opt}" op="==" rhs="4"]  
   [goto name="testbgm"]
[endif]
[goto name="testbgm"]

[label name="testbgm"]
[choose text1="测试bgm播放" text2="停止bgm播放" text3="进入下一个测试" name="opt" value1="1" value2="2" value3="3"]
[if lhs="${opt}" op="==" rhs="1"]
   [text text="使用【volume span=1.0】会导致无声"]
   [bgm file="sound/bgm/start.ogg"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [bgm file="none"]
[elseif lhs="${opt}" op="==" rhs="3"]
   [goto name="testcallmacro"]
[endif]
[click]
[goto name="testbgm"]

[label name="testcallmacro"]
[choose text1="测试无参数宏调用" text2="测试有参数宏调用" text3="进入下一个测试" name="opt" value1="1" value2="2" value3="3"]
[if lhs="${opt}" op="==" rhs="1"]
   [callmacro name="testmacro"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [callmacro name="testmacro2" arg1="parameter1"]
[elseif lhs="${opt}" op="==" rhs="3"]
   [goto name="testch"]
[endif]
[click]
[goto name="testcallmacro"]

[label name="testch"]
[choose text1="测试角色左边" text2="测试角色中间" text3="测试角色右边" text4="测试一起显示" text5="进入下一个测试"
name="opt" value1="1" value2="2" value3="3" value4="4" value5="5"]
[if lhs="${opt}" op="==" rhs="1"]
   [ch left="images/ch/midori/midori-normal.png"]
   [ch center="none" right="none"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [ch center="images/ch/midori/midori-normal.png"]
   [ch left="none" right="none"]
[elseif lhs="${opt}" op="==" rhs="3"]
   [ch right="images/ch/midori/midori-normal.png"]
   [ch left="none" center="none"]
[elseif lhs="${opt}" op="==" rhs="4"]
   [ch left="images/ch/midori/midori-normal.png" center="images/ch/aki/aki-normal.png" right="images/ch/xiaoling/xiaoling-normal.png"]
[elseif lhs="${opt}" op="==" rhs="5"]
   [goto name="testch2"]
[endif]
[goto name="testch"]

[label name="testch2"]
# 错误: start.novel:136: Tag ch: Property method is not allowed for tag ch.
[choose text1="测试角色淡入左侧" text2="测试角色淡入中间" text3="测试角色淡入右侧" text4="测试角色淡入一起显示" text5="进入下一个测试"
name="opt" value1="1" value2="2" value3="3" value4="4" value5="5"]
[if lhs="${opt}" op="==" rhs="1"]
   [ch left="images/ch/midori/midori-normal.png" time="1.0" method="normal"]
   [ch left="images/ch/midori/midori-normal.png" time="1.0" method="rule" rule="images/rule/bg_rule_image/001.png"]
   [ch left="images/ch/midori/midori-normal.png" time="1.0" method="melt" rule="images/rule/bg_rule_image/001.png"]
[elseif lhs="${opt}" op="==" rhs="2"]
  [ch center="images/ch/midori/midori-normal.png" time="1.0" method="normal"]
  [ch center="images/ch/midori/midori-normal.png" time="1.0" method="rule" rule="images/rule/bg_rule_image/001.png"]
  [ch center="images/ch/midori/midori-normal.png" time="1.0" method="melt" rule="images/rule/bg_rule_image/001.png"]
[elseif lhs="${opt}" op="==" rhs="3"]
   [ch right="images/ch/midori/midori-normal.png" time="1.0" method="normal"]
   [ch right="images/ch/midori/midori-normal.png" time="1.0" method="rule" rule="images/rule/bg_rule_image/001.png"]
   [ch right="images/ch/midori/midori-normal.png" time="1.0" method="melt" rule="images/rule/bg_rule_image/001.png"]
[elseif lhs="${opt}" op="==" rhs="4"]
   [ch left="images/ch/midori/midori-normal.png" center="images/ch/aki/aki-normal.png" right="images/ch/xiaoling/xiaoling-normal.png" time="1.0" method="normal"]
   [ch left="images/ch/midori/midori-normal.png" center="images/ch/aki/aki-normal.png" right="images/ch/xiaoling/xiaoling-normal.png" time="1.0" method="rule" rule="images/rule/bg_rule_image/001.png"]
   [ch left="images/ch/midori/midori-normal.png" center="images/ch/aki/aki-normal.png" right="images/ch/xiaoling/xiaoling-normal.png" time="1.0" method="melt" rule="images/rule/bg_rule_image/001.png"]
[elseif lhs="${opt}" op="==" rhs="5"]

[endif]
[goto name="testgui"]

[label name="testgui"]
[choose text1="测试gui" text2="进入下一个测试" name="opt" value1="1" value2="2"]
[if lhs="${opt}" op="==" rhs="1"]
   [gui file="system/title/title.gui"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [goto name="testload"]
[endif]
[goto name="testgui"]

[label name="testload"]
[choose text1="测试load" text2="进入下一个测试" name="opt" value1="1" value2="2"]
[if lhs="${opt}" op="==" rhs="1"]
   [load file="scene2.novel"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [goto name="testlayer"]
[endif]
[goto name="testload"]

[label name="testlayer"]
[choose text1="测试图层控制" text2="进入下一个测试" name="opt" value1="1" value2="2"]
[if lhs="${opt}" op="==" rhs="1"]
   [text text="缩放测试"]
   [layer name="bg" file="images/bg/school.png" scale-x="10"]
   [text text="旋转测试"]
   [layer name="bg" file="images/bg/school.png" rotate="45" scale-x="1"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [layer name="bg" file="images/bg/school.png" scale-x="1" scale-y="1" rotate="0"]
   [goto name="testmove"]
[endif]
[goto name="testlayer"]

# 错误: start.novel:194: Tag move: Property face-alpha is not allowed for tag move.
[label name="testmove"]
[choose text1="测试move标签" text2="进入下一个测试" name="opt" value1="1" value2="2"]
[if lhs="${opt}" op="==" rhs="1"]
   [move time="2.0" center-x="150" center-y="100"]
   [move time="1.0" bg-x="r50"]
   [text text="在旋转的同时逐渐淡出图层"]
   [ch center="images/ch/midori/midori-normal.png"]
   [move time="3.0" name="face" face-alpha="0" face-rotate="r360"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [goto name="testpencil"]
[endif]

[label name="testpencil"]
[choose text1="测试画笔" text2="进入下一个测试" name="opt" value1="1" value2="2"]
[if lhs="${opt}" op="==" rhs="1"]
   [bg file="images/bg/school.png"]
   [ch center="images/ch/midori/midori-normal.png"]
   [text text="测试画笔"]
   [pencil layer="bg" font-size="30" text="hello world" x="640" y="360"]
   [pencil layer="chc" font-size="30" text="hello world" x="640" y="360"]
   [pencil layer="text1" font-size="30" text="hello world" x="640" y="360"]
   [pencil layer="text2" font-size="30" text="hello world" x="640" y="360"]
   [pencil layer="text3" font-size="30" text="hello world" x="640" y="360"]
   [pencil layer="text4" font-size="30" text="hello world" x="640" y="360"]
   [pencil layer="text5" font-size="30" text="hello world" x="640" y="360"]
   [pencil layer="text6" font-size="30" text="hello world" x="640" y="360"]
   [pencil layer="text7" font-size="30" text="hello world" x="640" y="360"]
   [pencil layer="text8" font-size="30" text="hello world" x="640" y="360"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [goto name="returnmacro"]
[endif]
[goto name="testpencil"]

[label name="returnmacro"]
[choose text1="测试returnmacro" text2="进入下一个测试" name="opt" value1="1" value2="2"]
[if lhs="${opt}" op="==" rhs="1"]
   [set name="has_key" value="false"]
   [callmacro name="returnmacro"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [goto name="testse"]
[endif]
[goto name="returnmacro"]

[label name="testse"]
[choose text1="测试se标签" text2="进入下一个测试" name="opt" value1="1" value2="2"]
[if lhs="${opt}" op="==" rhs="1"]
   [se file="sound/se/click.ogg"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [goto name="testvar"]
[endif]
[goto name="testse"]

[label name="testvar"]
[choose text1="测试变量" text2="进入下一个测试" name="opt" value1="1" value2="2"]
[if lhs="${opt}" op="==" rhs="1"]
   [text text="字符串变量赋值"]
   [set name="str" value="hello world"]
   [text text="${str}"]
   [set name="str" value=""]

   [text text="数字变量赋值"]
   [set name="number" value="0"]
   [text text="${number}"]
   [text text="数组变量运算+"]
   [set name="number" value1="${number}" op="+" value2="1"]
   [text text="${number}"]
   [text text="数组变量运算-"]
   [set name="number" value="0"]
   [set name="number" value1="${number}" op="-" value2="1"]
   [text text="${number}"]
   [text text="数组变量运算*"]
   [text text="a=1 a*2"]
   [set name="number" value="1"]
   [set name="number" value1="${number}" op="*" value2="2"]
   [text text="${number}"]
   [text text="数组变量运算/"]
   [text text="a=1 a/2"]
   [set name="number" value="1"]
   [set name="number" value1="${number}" op="/" value2="2"]
   [text text="${number}"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [goto name="testskip"]
[endif]
[goto name="testvar"]

[label name="testskip"]
[choose text1="启用skip" text2="禁用skip" text3="进入下一个测试" name="opt" value1="1" value2="2" value3="3"]
[if lhs="${opt}" op="==" rhs="1"]
   [skip enable="true"]
   [text text="skip已启用，此选项会跳转回第一个测试tag，因为skip只能跳过已经阅读过的文本"]
   [goto name="testanime"]
[elseif lhs="${opt}" op="==" rhs="2"]
   [skip enable="false"]
   [text text="skip已禁用"]
[elseif lhs="${opt}" op="==" rhs="3"]
  [goto name="testtext"]
[endif]
[goto name="testskip"]

[label name="testtext"]
[text text="测试文本标签"]
[text text="旁白风格（不显示名字）"]
[text text="The wind was howling through the trees."]
[text text="角色对话"]
[text name="Keith" text="I've been waiting for you here in the small room."]
[text text="voice测试"]
[text name="Midori" voice="sound/voice/002.ogg" text="Sure! I'd love some fruitcake."]

[label name="testvideo"]
[text text="测试视频标签"]
[video file="images/test.mp4"]

[label name="testvolume"]
[text text="bgm 0.5"]
[volume track="bgm" volume="0.5"]
[bgm file="sound/bgm/start.ogg"]
[text text="se 0.5"]
[volume track="se" volume="0.5"]
[se file="sound/se/click.ogg"]
[text text="voice 0.5"]
[volume track="voice" volume="0.5"]
[se file="sound/voice/002.ogg"]
[text text="禁音所有通道"]
[volume track="bgm" volume="0"]
[volume track="se" volume="0"]
[volume track="voice" volume="0"]

[label name="testwait"]
[text text="测试等待标签"]
[text text="等待1秒"]
[ch center="images/ch/midori/midori-normal.png"]
[wait time="1.0"]
[text text="wait之后的代码"]

[click]

# Show a background image.

# Finish. The app will be closed.

#
# ---
#

#
# Macro to start NVL mode.
#
[defmacro name="nvl-mode"]
   [text action="hide"]
   [wait time="0.3"] # Wait for the message box to hide.
   [config name="game.novel" value="true"]
   [config name="msgbox.image" value="system/message/msgbox-nvl.png"]
   [config name="msgbox.x" value="0"]
   [config name="msgbox.y" value="0"]
   [config name="msgbox.margin.line" value="60"]
   [config name="namebox.enable" value="false"]
   [config name="choose.box1.idle" value="system/choose/nvl.png"]
   [config name="choose.box1.hover" value="system/choose/nvl.png"]
   [config name="choose.box1.idle_anime" value="system/choose/idle-nvl.anime"]
   [config name="choose.box1.hover_anime" value="system/choose/hover-nvl.anime"]
   [config name="choose.box2.idle" value="system/choose/nvl.png"]
   [config name="choose.box2.hover" value="system/choose/nvl.png"]
   [config name="choose.box2.idle_anime" value="system/choose/idle-nvl.anime"]
   [config name="choose.box2.hover_anime" value="system/choose/hover-nvl.anime"]
   [config name="choose.box3.idle" value="system/choose/nvl.png"]
   [config name="choose.box3.hover" value="system/choose/nvl.png"]
   [config name="choose.box3.idle_anime" value="system/choose/idle-nvl.anime"]
   [config name="choose.box3.hover_anime" value="system/choose/hover-nvl.anime"]
   [config name="click.move" value="true"]
   [text action="clear"]
[endmacro]

#
# Macro to go back ADV mode.
#
[defmacro name="adv-mode"]
   [text action="hide"]
   [wait time="0.3"] # Wait for the message box to hide.
   [config name="game.novel" value="false"]
   [config name="msgbox.image" value="system/message/msgbox.png"]
   [config name="msgbox.x" value="0"]
   [config name="msgbox.y" value="520"]
   [config name="msgbox.margin.line" value="40"]
   [config name="namebox.enable" value="true"]
   [config name="choose.box1.idle" value="system/choose/idle.png"]
   [config name="choose.box1.hover" value="system/choose/hover.png"]
   [config name="choose.box1.idle_anime" value="system/choose/idle.anime"]
   [config name="choose.box1.hover_anime" value="system/choose/hover.anime"]
   [config name="choose.box2.idle" value="system/choose/idle.png"]
   [config name="choose.box2.hover" value="system/choose/hover.png"]
   [config name="choose.box2.idle_anime" value="system/choose/idle.anime"]
   [config name="choose.box2.hover_anime" value="system/choose/hover.anime"]
   [config name="choose.box3.idle" value="system/choose/idle.png"]
   [config name="choose.box3.hover" value="system/choose/hover.png"]
   [config name="choose.box3.idle_anime" value="system/choose/idle.anime"]
   [config name="choose.box3.hover_anime" value="system/choose/hover.anime"]
   [config name="click.move" value="false"]
[endmacro]
